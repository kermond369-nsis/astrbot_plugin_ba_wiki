# 复制成同目录的 proxy.env 再改：cp proxy.env.example proxy.env
# 这个文件里有共享密钥，别提交进任何仓库。

# 客户端（AstrBot 插件）调用时带的 X-Proxy-Key，两边必须一致
# 生成：openssl rand -hex 16
PROXY_KEY=

# 容器内监听端口（与 compose 的端口映射对应，一般不用改）
PROXY_PORT=30303

# 上游
UPSTREAM=https://api.arona.icu

# token 文件
TOKEN_FILE=/config/arona_token.txt

# 单次请求体上限（字节）与上游超时（秒）
MAX_BODY_BYTES=131072
UPSTREAM_TIMEOUT=25
