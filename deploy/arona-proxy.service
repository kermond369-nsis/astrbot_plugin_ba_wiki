# 【LEGACY / 已弃用，仅作回滚备件保留】2026-10-18 起插件直连 api.arona.icu，
# 这台转发机随云服务器移交下线，线上已无该单元。要重新启用见
# docs/MIGRATE-TO-LOCAL.md 第八节（回滚）。密钥一律走 EnvironmentFile，不进仓库。
[Unit]
Description=arona.icu HTTPS API proxy (IP-bound token forwarder) [LEGACY]
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PROXY_BIND=0.0.0.0
Environment=PROXY_PORT=8443
EnvironmentFile=-/etc/arona-proxy.env
# 密钥不要写进仓库；在 /etc/arona-proxy.env 里放 PROXY_KEY=<openssl rand -hex 16>
Environment=PROXY_KEY=
Environment=ARONA_TOKEN_FILE=/root/.arona_token
Environment=PROXY_CERT=/etc/arona-proxy/arona-proxy.crt
Environment=PROXY_KEYFILE=/etc/arona-proxy/arona-proxy.key
ExecStart=/usr/bin/python3 /usr/local/bin/arona_proxy.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
